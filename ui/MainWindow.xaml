<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipKeeper" Width="1080" Height="760"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- overview tile -->
        <DataTemplate x:Key="TileTpl">
            <Border x:Name="tile" Style="{StaticResource CardBorder}" Margin="6" Padding="16,14" Cursor="{Binding Cursor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{StaticResource Muted}" FontSize="14"/>
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource Muted}"
                                   Margin="0,0,8,0" Visibility="{Binding ArrowVis}"/>
                        <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="16.5"
                               FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="12"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource LineHi}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- log line -->
        <DataTemplate x:Key="EventTpl">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Top" Margin="0,1,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                           FontSize="12" Margin="14,2,10,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#D4D4D8"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RecentTpl">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                           FontSize="12" Margin="14,0,10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" TextTrimming="CharacterEllipsis" Foreground="#D4D4D8"
                           VerticalAlignment="Center" ToolTip="{Binding Text}"/>
            </Grid>
        </DataTemplate>

        <!-- clip card -->
        <DataTemplate x:Key="ClipTpl">
            <Border x:Name="card" Width="236" Margin="0,0,12,12" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <!-- Tag="thumb": the mouse over it scrolls through the clip's frames (MainWindowScrub.cs) -->
                    <Grid Height="133" Margin="5,5,5,0" Tag="thumb" Background="Transparent">
                        <Border CornerRadius="7" Background="#0F1012">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="22" Foreground="#2E3036" HorizontalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="7" Background="{Binding Thumb}"/>
                        <Border CornerRadius="7" Background="{Binding Scrub}"/>
                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource Brand}"
                                Width="{Binding ScrubWidth}" Visibility="{Binding ScrubVis}"/>
                        <Border CornerRadius="5" Background="#CC0B0C0E" Padding="6,1" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding DurationVis}">
                            <TextBlock Text="{Binding Duration}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="White"/>
                        </Border>
                        <Border CornerRadius="5" Background="{StaticResource Brand}" Padding="7,1" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding NewVis}">
                            <TextBlock Text="latest¦последний" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnBrand}"/>
                        </Border>
                        <Button x:Name="star" Style="{StaticResource BtnBare}" Tag="fav" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Opacity="{Binding StarOpacity}" ToolTip="{Binding StarTip}">
                            <Border CornerRadius="6" Background="#CC0B0C0E" Width="28" Height="26">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding StarGlyph}" Foreground="{Binding StarBrush}" FontSize="13"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </Grid>
                    <StackPanel Margin="12,10,12,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- actions show on hover: a grid of cards stays calm -->
                    <Grid x:Name="actions" Margin="5,4,5,6" Opacity="0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnLink}" Tag="open" ToolTip="Open in player¦Открыть в плеере">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource BtnLink}" Tag="trim" ToolTip="Trim¦Обрезать">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource BtnLink}" Tag="folder" ToolTip="Show in folder¦Показать в папке">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource BtnLink}" Tag="copy" ToolTip="Copy the file — then Ctrl+V into Discord or Telegram¦Копировать файл — потом Ctrl+V в Discord или Telegram">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource BtnLink}" Tag="return" Visibility="{Binding ReturnVis}" ToolTip="{Binding ReturnTip}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource BtnLink}" Tag="delete" HorizontalAlignment="Right" ToolTip="Move to Recycle Bin¦В корзину">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DeleteText}" Foreground="{StaticResource Bad}" FontSize="12.5" Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LineHi}"/>
                    <Setter TargetName="star" Property="Opacity" Value="1"/>
                    <Setter TargetName="actions" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger SourceName="card" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="actions" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- game card in the library: 2:3 cover, name, clip count and total length -->
        <DataTemplate x:Key="GameTpl">
            <Button Style="{StaticResource BtnBare}" Tag="game" Margin="0,0,16,18" ToolTip="{Binding Tip}">
                <StackPanel x:Name="card" Width="164">
                    <Grid Height="246">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,164,246" RadiusX="10" RadiusY="10"/>
                        </Grid.Clip>
                        <Border Background="{StaticResource Card2}"/>
                        <!-- a frame of the game's latest clip, blurred: what a logo, a wide picture or the letters lie on -->
                        <Border Background="{Binding Backdrop}" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <BlurEffect Radius="16"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Background="#990B0C0E" Visibility="{Binding BackdropVis}"/>
                        <TextBlock Text="{Binding InitialsText}" Visibility="{Binding InitialsVis}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="42" FontWeight="SemiBold" Foreground="{Binding InitialsBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Favorites, All clips, Desktop: the latest clips fanned out over the whole card, the newest in front, all opaque,
                             on its own blurred copy; the icon sits in the corner opposite the count -->
                        <Grid Visibility="{Binding GlyphVis}">
                            <Border Background="{Binding Frame0}" RenderTransformOrigin="0.5,0.5" Visibility="{Binding MosaicVis}">
                                <Border.Effect>
                                    <BlurEffect Radius="18"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Background="#8C0B0C0E"/>
                            <Canvas Visibility="{Binding MosaicVis}">
                                <Border Canvas.Left="26" Canvas.Top="{Binding Top5}" Width="128" Height="72" CornerRadius="6" Background="{Binding Frame5}"
                                        Visibility="{Binding Frame5Vis}" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="-9"/></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="10" Canvas.Top="{Binding Top4}" Width="128" Height="72" CornerRadius="6" Background="{Binding Frame4}"
                                        Visibility="{Binding Frame4Vis}" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="7"/></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="24" Canvas.Top="{Binding Top3}" Width="128" Height="72" CornerRadius="6" Background="{Binding Frame3}"
                                        Visibility="{Binding Frame3Vis}" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="-6"/></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="8" Canvas.Top="{Binding Top2}" Width="128" Height="72" CornerRadius="6" Background="{Binding Frame2}"
                                        Visibility="{Binding Frame2Vis}" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="6"/></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="22" Canvas.Top="{Binding Top1}" Width="128" Height="72" CornerRadius="6" Background="{Binding Frame1}"
                                        Visibility="{Binding Frame1Vis}" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="18" Canvas.Top="{Binding Top0}" Width="128" Height="72" CornerRadius="6" Background="{Binding Frame0}"
                                        Visibility="{Binding Frame0Vis}" BorderBrush="#40FFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="0"/></Border.RenderTransform>
                                </Border>
                            </Canvas>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding GlyphText}" FontSize="26" Foreground="{Binding GlyphBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoMosaicVis}"/>
                            <Border CornerRadius="5" Background="#CC0B0C0E" Padding="6,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding MosaicVis}">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding GlyphText}" FontSize="12" Foreground="{Binding GlyphBrush}"/>
                            </Border>
                        </Grid>
                        <Border Background="{Binding Cover}"/>
                        <!-- a dark logo on a transparent background: drawn white, it reads on the dark card -->
                        <Border Background="White" OpacityMask="{Binding CoverMask}" Visibility="{Binding CoverMaskVis}"/>
                        <Border x:Name="ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"/>
                        <Border CornerRadius="5" Background="#CC0B0C0E" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="11" Foreground="#D4D4D8" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CountText}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="coverBtn" Style="{StaticResource BtnBare}" Tag="cover" Margin="6" Opacity="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding CoverBtnVis}" ToolTip="Set your own cover¦Поставить свою обложку">
                            <Border CornerRadius="6" Background="#CC0B0C0E" Width="28" Height="26">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatsText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BrandHi}"/>
                    <Setter TargetName="coverBtn" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ── sidebar: the pages; on the settings page it turns into the list of settings sections ── -->
        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid>
            <DockPanel x:Name="MainSide">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,0,24">
                    <Grid Width="26" Height="26">
                        <Viewbox>
                            <Grid Width="40" Height="40">
                                <Path Data="M20,2.5 L35,8.5 V19.5 C35,29 28.5,35 20,38 C11.5,35 5,29 5,19.5 V8.5 Z" Fill="{StaticResource Brand}"/>
                                <Path Data="M16.5,13.2 L27.2,19.8 L16.5,26.4 Z" Fill="{StaticResource OnBrand}" Stroke="{StaticResource OnBrand}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="ClipKeeper" FontFamily="{StaticResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold"
                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- OBS link and recording: a pulsing red dot while the buffer records; a click opens Recording -->
                <Border x:Name="SideStatus" DockPanel.Dock="Bottom" Margin="14,14,14,16" Padding="12,10" CornerRadius="8"
                        Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SideHalo" Width="7" Height="7" Fill="{StaticResource Bad}" VerticalAlignment="Center" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="SideDot" Width="7" Height="7" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock x:Name="SideConn" Text="OBS: connecting…¦OBS: подключение…" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SideSub" Text="" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="15" Width="28"/>
                            <TextBlock Text="Library¦Библиотека"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStats" Style="{StaticResource Nav}" GroupName="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="15" Width="28"/>
                            <TextBlock Text="Statistics¦Статистика"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRecord" Style="{StaticResource Nav}" GroupName="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="15" Width="28"/>
                            <TextBlock Text="Recording¦Запись"/>
                            <!-- a recording problem — a dot in its severity color -->
                            <Ellipse x:Name="NavRecordDot" Width="7" Height="7" Margin="10,1,0,0" VerticalAlignment="Center"
                                     Visibility="Collapsed" Fill="{StaticResource Bad}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" Width="28"/>
                            <TextBlock Text="Settings¦Настройки"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- settings: back to the page you came from, the search and the sections in groups (built in MainWindowSettings.cs) -->
            <DockPanel x:Name="SettingsSide" Visibility="Collapsed">
                <Button x:Name="SettingsBack" DockPanel.Dock="Top" Style="{StaticResource BtnLink}" Foreground="{StaticResource Text}"
                        HorizontalAlignment="Left" Margin="12,12,0,10" Padding="8,6,12,6" ToolTip="Back (Esc)¦Назад (Esc)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="14" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings¦Настройки" FontFamily="{StaticResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel x:Name="SettingsHead" DockPanel.Dock="Top" Margin="14,0,14,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsNav" Margin="10,0,10,8"/>
                </ScrollViewer>
            </DockPanel>
            </Grid>
        </Border>

        <!-- ── content ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMin" Style="{StaticResource ChromeBtn}" Content="&#xE921;"/>
                <Button x:Name="BtnMax" Style="{StaticResource ChromeBtn}" Content="&#xE922;"/>
                <Button x:Name="BtnClose" Style="{StaticResource ChromeClose}" Content="&#xE8BB;"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Recording: status, tiles, sources, log -->
                <ScrollViewer x:Name="PageRecord" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,0,34,30">
                        <TextBlock Text="Recording¦Запись" Style="{StaticResource H1}" Margin="0,0,0,18"/>

                        <Border x:Name="Hero" Style="{StaticResource CardBorder}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="HeroStripe" CornerRadius="10,0,0,10" Background="{StaticResource Ok}"/>
                                <Grid Grid.Column="1" Margin="24,24,22,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                                <Ellipse x:Name="HeroHalo" Fill="{StaticResource Bad}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="HeroDot" Fill="{StaticResource Ok}"/>
                                            </Grid>
                                            <TextBlock x:Name="HeroLabel" Text="RUNNING¦РАБОТАЕТ" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ok}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroTitle" Text="All good¦Всё в порядке" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" TextOptions.TextFormattingMode="Ideal"/>
                                        <TextBlock x:Name="HeroDetail" Text="" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCheck" Grid.Column="1" Style="{StaticResource BtnGhost}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Check¦Проверить"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="ProblemsCard" Visibility="Collapsed" Margin="0,12,0,0" Style="{StaticResource CardBorder}" Padding="18,12">
                            <ItemsControl x:Name="ProblemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                                                       FontSize="13" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                            <!-- the click is handled on the list (MainWindow.cs) -->
                                            <Button Grid.Column="2" Style="{StaticResource BtnLink}" Visibility="{Binding LinkVis}"
                                                    Margin="12,-4,-8,0" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding LinkText}"/>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="6,1,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ItemsControl x:Name="Tiles" Margin="-6,12,-6,0" ItemTemplate="{StaticResource TileTpl}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- sources: cards are built in code -->
                        <!-- sources: folded while everything is fine, opens by itself on a device problem -->
                        <Grid x:Name="SourcesHeader" Margin="0,28,0,4">
                            <Button x:Name="BtnSourcesFold" Style="{StaticResource BtnBare}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="Show or hide the devices and tracks¦Показать или скрыть устройства и дорожки">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <TextBlock x:Name="SourcesChevron" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Width="20"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="Sources¦Источники" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SourcesSummary" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="12,2,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSave" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="Changed something right in OBS? Remember the current state, otherwise ClipKeeper restores the reference¦Поменял что-то прямо в OBS? Запомни текущее состояние, иначе ClipKeeper вернёт эталон">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Remember from OBS¦Запомнить из OBS"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="SourcesBody" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,14"
                                   Text="Devices and tracks ClipKeeper keeps in OBS. Change them here — it applies them in OBS and remembers right away, nothing gets rolled back.¦Устройства и дорожки, которые ClipKeeper держит в OBS. Меняй их здесь — он применит в OBS и сразу запомнит, откатывать ничего не будет."/>
                        <StackPanel x:Name="SourcesPanel"/>
                        <TextBlock x:Name="SourcesEmpty" Visibility="Collapsed" Style="{StaticResource SubText}" Margin="2,0,0,12"
                                   Text="The reference is empty: set up devices in OBS and press &quot;Remember from OBS&quot;.¦Эталон пуст: настрой устройства в OBS и нажми «Запомнить из OBS»."/>
                        </StackPanel>

                        <!-- log and actions -->
                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="272"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="20,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Log¦Журнал" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnOpenLog" Style="{StaticResource BtnLink}" HorizontalAlignment="Right" ToolTip="Open the whole log file¦Открыть файл журнала целиком">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                    <ItemsControl x:Name="EventsList" ItemTemplate="{StaticResource EventTpl}"/>
                                    <TextBlock x:Name="EventsEmpty" Text="All quiet so far¦Пока тихо" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Actions¦Действия" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Button x:Name="BtnTest" Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                        <TextBlock Text="Test alarm¦Тест тревоги"/>
                                    </Button>
                                    <Button x:Name="BtnRestart" Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Restart OBS¦Перезапустить OBS"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Library -->
                <ScrollViewer x:Name="PageClips" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                  <Grid>
                    <!-- game banner: Steam art or a clip frame; goes under the window buttons and fades into the background -->
                    <Grid x:Name="HeroBox" Height="320" VerticalAlignment="Top" Visibility="Collapsed" Background="{StaticResource Bg}" ClipToBounds="True">
                        <Border x:Name="HeroImage"/>
                        <Border x:Name="HeroDim" Background="#00000000"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#A60B0C0E" Offset="0"/>
                                    <GradientStop Color="#000B0C0E" Offset="0.22"/>
                                    <GradientStop Color="#000B0C0E" Offset="0.4"/>
                                    <GradientStop Color="#E60B0C0E" Offset="0.82"/>
                                    <GradientStop Color="#FF0B0C0E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Button x:Name="BtnHero" Style="{StaticResource BtnBare}" Margin="0,56,34,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Opacity="0" ToolTip="Set your own banner picture¦Поставить свою картинку для баннера">
                            <Border CornerRadius="6" Background="#CC0B0C0E" Width="30" Height="28">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="ClipsBody" Margin="34,0,22,30">
                        <Grid Margin="0,0,12,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnClipsBack" Style="{StaticResource BtnIcon}" Content="&#xE72B;" Visibility="Collapsed"
                                    VerticalAlignment="Top" Margin="0,2,14,0" ToolTip="Back to the library (Backspace)¦К библиотеке (Backspace)"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ClipsTitle" Text="Clips¦Клипы" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, ElementName=ClipsFolder}"/>
                                <!-- the folder path is only a tooltip (on the title and the folder button) -->
                                <TextBlock x:Name="ClipsFolder" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0">
                                <Button x:Name="BtnSortClips" Style="{StaticResource BtnGhost}" Visibility="Collapsed" Margin="0,0,6,0"
                                        ToolTip="Move to the collection, into game folders, every ready clip where ClipKeeper recorded the game¦Перенести в коллекцию, по папкам игр, все готовые клипы, в которых ClipKeeper записал игру">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="All to collection¦Всё в коллекцию"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClipsRefresh" Style="{StaticResource BtnIcon}" Content="&#xE72C;" Margin="0,0,6,0" ToolTip="Refresh¦Обновить"/>
                                <Button x:Name="BtnClipsFolder" Style="{StaticResource BtnIcon}" Content="&#xE838;" ToolTip="{Binding Text, ElementName=ClipsFolder}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,12,16">
                            <StackPanel x:Name="ClipSource" Orientation="Horizontal"/>
                            <TextBlock x:Name="ClipsStats" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12.5"/>
                        </Grid>
                        <!-- the search, filters and the order of clips (MainWindowFind.cs); filters wrap in a narrow window -->
                        <Grid x:Name="ClipsTools" Margin="0,0,12,14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ClipsSearchHost" Width="220" VerticalAlignment="Top"/>
                            <WrapPanel x:Name="ClipsFilters" Grid.Column="1" Margin="10,3,0,-6" VerticalAlignment="Top"/>
                            <Button x:Name="BtnClipsSort" Grid.Column="2" Style="{StaticResource BtnLink}" VerticalAlignment="Top" Margin="8,4,0,0"
                                    ToolTip="The order of clips¦Порядок клипов"/>
                        </Grid>
                        <Border x:Name="SortCard" Visibility="Collapsed" Style="{StaticResource CardBorder}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock x:Name="SortTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="SortList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="0,2" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnSortGo" Style="{StaticResource BtnPrimary}" Content="Move¦Переместить"/>
                                    <Button x:Name="BtnSortCancel" Style="{StaticResource BtnLink}" Content="Cancel¦Отмена" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource GameTpl}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl x:Name="ClipsList" ItemTemplate="{StaticResource ClipTpl}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="ClipsEmpty" Visibility="Collapsed" Style="{StaticResource SubText}" Text="No clips yet.¦Клипов пока нет."/>
                        <Button x:Name="BtnSearchAll" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,4,0,12"/>
                        <Button x:Name="BtnClipsMore" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Visibility="Collapsed" Content="Show more¦Показать ещё"/>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>

                <!-- Statistics: built in code (MainWindowStats.cs) -->
                <ScrollViewer x:Name="PageStats" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StatsPanel" Margin="34,0,34,30"/>
                </ScrollViewer>

                <!-- Settings: the chosen section; the sections themselves are in the sidebar. Built in code (MainWindowSettings.cs) -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsPanel" Margin="34,0,34,30"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
